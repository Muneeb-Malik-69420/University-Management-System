PORT=4000
# Leave blank for the persistent local demo. Set to use PostgreSQL.
DATABASE_URL=
# Explicit opt-in: creates sample data and the documented demo accounts.
SEED_DEMO=true
# Set true only behind HTTPS in deployment.
COOKIE_SECURE=false

# Render: HOST=0.0.0.0, TRUST_PROXY=1, NODE_ENV=production, COOKIE_SECURE=true
# Keep TRUST_PROXY unset when running directly without a reverse proxy.
